{
  "name": "nodejs-fullstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/load-local-env.ts && node --watch-path=server --watch-path=scripts --watch-preserve-output scripts/dev.ts",
    "db:push": "mkdir -p .dev && drizzle-kit push --verbose",
    "db:export": "mkdir -p .dev && drizzle-kit export > .dev/schema.sql",
    "db:diff": "pnpm db:export && atlas migrate diff --env sqlite",
    "typecheck": "tsc -b",
    "check": "biome check && pnpm typecheck",
    "lint:fix": "biome lint --write",
    "fmt:fix": "biome format --write",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node26 --sourcemap --out-extension:.js=.cjs --entry-names='[dir]/[name]' --outdir=build",
    "build": "rm -rf build && pnpm build:server && vite build"
  },
  "imports": {
    "#/*": "./*",
    "#/client/components/*": "./client/components/*",
    "#/client/lib/*": "./client/lib/*",
    "#/client/hooks/*": "./client/hooks/*"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "1.0.0-rc.5",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.8"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@effect/platform-node": "4.1.4",
    "@effect/sql-sqlite-node": "4.1.4",
    "@fontsource-variable/geist": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.1.4",
    "lucide-react": "1.76.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
