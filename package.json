{
  "name": "nodejs-fullstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=server --watch-path=scripts --watch-preserve-output scripts/dev.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node26 --sourcemap --out-extension:.js=.cjs --entry-names='[dir]/[name]' --outdir=build",
    "build": "rm -rf build && pnpm build:server && vite build"
  },
  "imports": {
    "#/*": "./*"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "vite": "8.3.8"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "effect": "4.1.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}